# Development environment for `zotero-plugin serve` / `zotero-plugin test`.
# Copy to `.env` and fill in. Anything already exported in your shell can be
# left out here.

# Zotero binary. On macOS this is
# /Applications/Zotero.app/Contents/MacOS/zotero; escape separators as `\\` on
# Windows.
ZOTERO_PLUGIN_ZOTERO_BIN_PATH = /path/to/zotero

# Development profile. Create one with `/path/to/zotero -p`.
# https://www.zotero.org/support/kb/profile_directory
ZOTERO_PLUGIN_PROFILE_PATH = /path/to/profile

# Data directory for that profile. Leave empty for Zotero's default.
# https://www.zotero.org/support/zotero_data
ZOTERO_PLUGIN_DATA_DIR =

# Override how Zotero is stopped between runs. zotero-plugin ships per-platform
# defaults; only set this if they do not suit the machine.
# ZOTERO_PLUGIN_KILL_COMMAND =

# Only needed when publishing a release from this machine instead of CI.
# GITHUB_TOKEN =
